+  def test_render_project_nested_lists_should_sort_projects_by_name_under_their_parent
+    html = render_project_nested_lists(Project.where(:id => [1, 3, 4, 5, 6]))
+    doc = Nokogiri::HTML.fragment(html)
+    assert_equal ['eCookbook'], doc.css('ul.projects.root > li.root > div.root').map(&:text)
+    assert_equal ['eCookbook Subproject 1', 'eCookbook Subproject 2', 'Private child of eCookbook'],
+                 doc.css('li.root > ul.projects > li.child > div.child').map(&:text)
+    assert_equal ['Child of private child'],
+                 doc.css('li.child > ul.projects > li.child > div.child').map(&:text)
+  end
+
+  def test_sort_project_tree_should_keep_children_under_their_parent
+    projects = sort_project_tree(Project.where(:id => [1, 2, 3, 4, 5, 6]))
+    assert_equal [1, 3, 4, 5, 6, 2], projects.map(&:id)
+  end
