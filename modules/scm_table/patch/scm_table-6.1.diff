+.settings.enabled_scm td.scm_name{ font-weight: bold; inline-size: 20%; white-space: nowrap; }
+.settings.enabled_scm td.scm_name label {display: inline-flex; align-items: center; gap: 4px;}
+.settings.enabled_scm th:last-child, .settings.enabled_scm td:last-child {inline-size: 15%;}
 
 fieldset.settings label { display: block; }
 fieldset#notified_events .parent { padding-left: 20px; }
