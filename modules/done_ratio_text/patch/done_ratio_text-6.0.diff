+
+  # Shows the value of a progress bar as text, placed as set in
+  # Administration > Settings > Issue tracking (#5284). A value whose text
+  # is left out (0 % or 100 %) keeps an empty place for it, so that every
+  # bar in a column has the same width and place.
+  def progress_bar_with_text(bar, pct)
+    position = Setting.progress_bar_text.to_s
+    return bar + content_tag('p', '', :class => 'percent') if position.blank?
+
+    css = (position == 'hidden') ? 'progress-text hidden-for-sighted' : 'progress-text'
+    text =
+      if (pct == 0 && !Setting.progress_bar_text_zero?) ||
+         (pct == 100 && !Setting.progress_bar_text_full?)
+        content_tag('span', '', :class => "#{css} progress-text-none", 'aria-hidden' => 'true')
+      else
+        content_tag('span', "#{pct}%", :class => css)
+      end
+    content_tag('div', bar + text,
+                :class => "progress-with-text progress-text-#{position}")
   end
 
