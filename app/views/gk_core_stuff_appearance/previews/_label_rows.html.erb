<%# Visa for a form's row with only text, drawn only from GK GUI Stuff's page Appearance with its helpers: core's tabular
    row with a label and a text, still, the text a little high as Redmine has it; with the setting, the same row with
    the text on the label's line (the picture's own rule, gk_core_stuff_pictures.css; the look's stylesheet comes only
    with the row on). row: the setting %>
<% gk_gui_stuff_preview_stylesheet('gk_core_stuff_pictures', plugin: 'gk_core_stuff') %>
<% rows = content_tag(:div, content_tag(:p, safe_join([content_tag(:label, l(:field_status)), l(:label_open_issues)], ' ')), class: 'tabular') %>
<% mid = method(:gk_gui_stuff_appearance_preview).parameters.map(&:last).include?(:mid_line) ? { mid_line: true } : {} %>
<%= gk_gui_stuff_appearance_preview(row, off: content_tag(:div, rows, class: 'gk-gui-stuff-sg-still', inert: true), on: content_tag(:div, rows, inert: true), **mid) %>
