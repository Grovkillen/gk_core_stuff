--- a/app/assets/stylesheets/application.css
+++ b/app/assets/stylesheets/application.css
@@ -1271,6 +1271,12 @@
   color: #A6750C;
 }
 
+/* A warning or a "no data" box draws no icon in the space kept at its start: the same space on both sides, and
+   no margin of the first and last child added to the padding. A flash message keeps its space for its icon. */
+:is(.nodata, .warning):not(div.flash) {padding-inline: 12px;}
+:is(.nodata, .warning):not(div.flash) > :first-child {margin-block-start: 0;}
+:is(.nodata, .warning):not(div.flash) > :last-child {margin-block-end: 0;}
+
 #errorExplanation ul { font-size: 0.9em;}
 #errorExplanation h2, #errorExplanation p { display: none; }
 
