+  def test_heads_for_i18n_should_include_validation_and_file_field_texts
+    with_locale 'en' do
+      heads = heads_for_i18n
+      assert_include '"validationValueMissing":"Fill in the field."', heads
+      assert_include '"validationTooShort":"Write at least %{count} characters."', heads
+      assert_include '"labelNoFileChosen":"No file chosen"', heads
+    end
+    with_locale 'sv' do
+      assert_include '"labelNoFileChosen":"Ingen fil vald"', heads_for_i18n
+    end
+  end
