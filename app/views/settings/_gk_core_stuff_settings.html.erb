<%# gk_core_stuff: first, with the gate closed, core's own warning line per plugin, which says the first thing that is
    not met: GK GUI Stuff is missing, it is too old (the line names the version required), or it is installed in the
    right version but not active (with a link to its own settings page); GK Compat is missing or too old (GK
    GUI Stuff may be the one missing, so nothing of it can draw the line) and the About box, and nothing else: the stored
    settings go back as hidden fields, because core's Save on this page writes what is posted over what is stored. With
    GK GUI Stuff and GK Compat one box per module that is not an
    appearance setting, each switchable except settings_tabs, journal_details and layout_hooks (always on, other plugins
    require them); a module core already has says so and cannot be switched on. The looks, the done ratio as text, AM/PM and the version in the footer are appearance settings on Administration > Appearance (GK GUI Stuff) %>
<% plugin = Redmine::Plugin.find(:gk_core_stuff) %>
<% gui_closed = GkCoreStuff.gui_closed %>
<% gui = gui_closed.nil? %>
<% if gui_closed == :missing %><p class="warning"><%= l(:text_gk_core_stuff_gui_stuff_missing) %></p>
<% elsif gui_closed == :old %><p class="warning"><%= l(:text_gk_core_stuff_gui_stuff_required, version: GkCoreStuff::GUI_STUFF_MIN) %></p>
<% elsif gui_closed == :inactive %><p class="warning"><%= l(:text_gk_core_stuff_gui_stuff_inactive) %> <%= link_to l(:label_gk_core_stuff_gui_stuff_settings), plugin_settings_path('gk_gui_stuff') %></p><% end %>
<% compat_closed = GkCoreStuff.compat_closed %>
<% compat = compat_closed.nil? %>
<% if compat_closed == :missing %><p class="warning"><%= l(:text_gk_core_stuff_compat_missing) %></p>
<% elsif compat_closed == :old %><p class="warning"><%= l(:text_gk_core_stuff_compat_required, version: GkCoreStuff::COMPAT_MIN) %></p><% end %>
<% open = gui && compat %>
<% s = GkCoreStuff.defaults.merge((settings || {}).to_h.transform_keys(&:to_s)) %>
<fieldset class="box"><legend><%= l(:label_gk_core_stuff_about) %></legend>
  <div><strong><%= plugin.name %></strong> <%= plugin.version %></div>
  <div><%= l(:text_gk_core_stuff_description) %></div>
</fieldset>
<% unless open %>
  <%# every stored value as a form posts it: a list as name[] (empty as [""]), a hash by its keys, the rest as text %>
  <% keep = nil %>
  <% keep = lambda do |name, value|
       case value
       when Hash then value.flat_map { |k, v| keep.call("#{name}[#{k}]", v) }
       when Array then value.empty? ? [hidden_field_tag("#{name}[]", '', id: nil)] : value.map { |v| hidden_field_tag("#{name}[]", v.to_s, id: nil) }
       else [hidden_field_tag(name, value.to_s, id: nil)]
       end
     end %>
  <%= safe_join((settings.is_a?(Hash) ? settings : {}).flat_map { |k, v| keep.call("settings[#{k}]", v) }) %>
<% else %>
<%# a module that is always on (GkCoreStuff.always?) shows so as a muted pill with a lock: it cannot be switched off,
    and nothing is sent with the form %>
<% always = lambda do
     gk_gui_stuff_pill(l(:label_gk_core_stuff_view_hooks_always), muted: true, icon_after: 'lock',
                                                                   icon_after_label: l(:text_gk_core_stuff_always_locked))
   end %>
<%# single_preference: one preference row per user %>
<fieldset class="box tabular"><legend><%= l(:label_gk_core_stuff_single_preference) %></legend>
  <p><label><%= l(:label_gk_core_stuff_module_on) %></label>
    <%= hidden_field_tag 'settings[single_preference]', '0', id: nil %>
    <%= check_box_tag 'settings[single_preference]', '1', s['single_preference'].to_s == '1' %>
    <em class="info"><%= l(:text_gk_core_stuff_single_preference_info) %></em></p>
</fieldset>
<%# avatar_sources: the register of picture sources other plugins add to %>
<fieldset class="box tabular"><legend><%= l(:label_gk_core_stuff_avatar_sources) %></legend>
  <p><label><%= l(:label_gk_core_stuff_module_on) %></label>
    <%= hidden_field_tag 'settings[avatar_sources]', '0', id: nil %>
    <%= check_box_tag 'settings[avatar_sources]', '1', s['avatar_sources'].to_s == '1' %>
    <em class="info"><%= l(:text_gk_core_stuff_avatar_sources_info) %></em></p>
  <p><label><%= l(:label_gk_core_stuff_avatar_sources_now) %></label>
    <%= GkCoreStuff::AvatarSources.sources.any? ? GkCoreStuff::AvatarSources.sources.map(&:key).join(', ') : l(:label_none) %></p>
</fieldset>
<%# minimagick_path: the Gantt chart as PNG with ImageMagick 7 (a restart applies a change) %>
<fieldset class="box tabular"><legend><%= l(:label_gk_core_stuff_minimagick_path) %></legend>
  <% if GkCoreStuff.in_core?(:minimagick_path) %>
    <p><em class="info"><%= l(:text_gk_core_stuff_in_core) %></em></p>
  <% else %>
  <p><label><%= l(:label_gk_core_stuff_module_on) %></label>
    <%= hidden_field_tag 'settings[minimagick_path]', '0', id: nil %>
    <%= check_box_tag 'settings[minimagick_path]', '1', s['minimagick_path'].to_s == '1' %>
    <em class="info"><%= l(:text_gk_core_stuff_minimagick_path_info) %></em></p>
  <% end %>
</fieldset>
<%# settings_tabs: the tabs other plugins register on the settings pages and in an issue's history (core_proposals/view_hooks) %>
<fieldset class="box tabular"><legend><%= l(:label_gk_core_stuff_settings_tabs) %></legend>
  <% if GkCoreStuff.in_core?(:settings_tabs) %>
    <p><em class="info"><%= l(:text_gk_core_stuff_in_core) %></em></p>
  <% else %>
  <p><label><%= l(:label_gk_core_stuff_module_on) %></label>
    <%= always.call %>
    <em class="info"><%= l(:text_gk_core_stuff_settings_tabs_info) %></em></p>
  <% now = GkCoreStuff::Tabs::PAGES.flat_map { |page| GkCoreStuff::Tabs.registered(page).map { |t| "#{page}: #{t[:name]}" } } %>
  <p><label><%= l(:label_gk_core_stuff_settings_tabs_now) %></label>
    <%= now.any? ? now.join(', ') : l(:label_none) %></p>
  <% end %>
</fieldset>
<%# journal_details: how other plugins' own lines in an issue's history are drawn (core_proposals/view_hooks) %>
<fieldset class="box tabular"><legend><%= l(:label_gk_core_stuff_journal_details) %></legend>
  <% if GkCoreStuff.in_core?(:journal_details) %>
    <p><em class="info"><%= l(:text_gk_core_stuff_in_core) %></em></p>
  <% else %>
  <p><label><%= l(:label_gk_core_stuff_module_on) %></label>
    <%= always.call %>
    <em class="info"><%= l(:text_gk_core_stuff_journal_details_info) %></em></p>
  <% now = GkCoreStuff::JournalDetails.registered %>
  <p><label><%= l(:label_gk_core_stuff_journal_details_now) %></label>
    <%= now.any? ? now.join(', ') : l(:label_none) %></p>
  <% end %>
</fieldset>
<%# formatting_processors: the one pass over formatted text's links and runs of text (core_proposals/formatting_processors) %>
<fieldset class="box tabular"><legend><%= l(:label_gk_core_stuff_formatting_processors) %></legend>
  <% if GkCoreStuff.in_core?(:formatting_processors) %>
    <p><em class="info"><%= l(:text_gk_core_stuff_in_core) %></em></p>
    <%# formatting_processors_values: the custom values' pass stays GK's own until core has one too %>
    <% unless GkCoreStuff.in_core?(:formatting_processors_values) %>
    <% now = GkCoreStuff::FormattingProcessors.registered %>
    <p><label><%= l(:label_gk_core_stuff_formatting_processors_now) %></label>
      <%= now.any? ? now.join(', ') : l(:label_none) %>
      <em class="info"><%= l(:text_gk_core_stuff_formatting_processors_values_info) %></em></p>
    <% end %>
  <% else %>
  <p><label><%= l(:label_gk_core_stuff_module_on) %></label>
    <%= always.call %>
    <em class="info"><%= l(:text_gk_core_stuff_formatting_processors_info) %></em></p>
  <% now = GkCoreStuff::FormattingProcessors.registered %>
  <p><label><%= l(:label_gk_core_stuff_formatting_processors_now) %></label>
    <%= now.any? ? now.join(', ') : l(:label_none) %></p>
  <% end %>
</fieldset>
<%# report_marks: the marks on the counts of core's issue reports (a prepend on ReportsHelper#aggregate_link) %>
<fieldset class="box tabular"><legend><%= l(:label_gk_core_stuff_report_marks) %></legend>
  <% if GkCoreStuff.in_core?(:report_marks) %>
    <p><em class="info"><%= l(:text_gk_core_stuff_in_core) %></em></p>
  <% else %>
  <p><label><%= l(:label_gk_core_stuff_module_on) %></label>
    <%= always.call %>
    <em class="info"><%= l(:text_gk_core_stuff_report_marks_info) %></em></p>
  <% end %>
</fieldset>
<%# principal_marks, breadcrumb_marks and menu_marks: marks on core's links to a user or group, on the breadcrumb's project links (prepends on ApplicationHelper) and on a menu's links (a prepend on the menu helper) %>
<% %i[principal_marks breadcrumb_marks menu_marks].each do |key| %>
<fieldset class="box tabular"><legend><%= l(:"label_gk_core_stuff_#{key}") %></legend>
  <% if GkCoreStuff.in_core?(key) %>
    <p><em class="info"><%= l(:text_gk_core_stuff_in_core) %></em></p>
  <% else %>
  <p><label><%= l(:label_gk_core_stuff_module_on) %></label>
    <%= always.call %>
    <em class="info"><%= l(:"text_gk_core_stuff_#{key}_info") %></em></p>
  <% end %>
</fieldset>
<% end %>
<%# the hooks and marks in core's views (core_proposals/view_hooks steps 01, 04, 05, 06, 08, 09 and 10): always on, one row per step %>
<fieldset class="box"><legend><%= l(:label_gk_core_stuff_view_hooks) %></legend>
  <p><em class="info"><%= l(:text_gk_core_stuff_view_hooks_info) %></em></p>
  <table class="list gk-core-stuff-view-hooks">
    <thead><tr><th><%= l(:field_name) %></th><th><%= l(:field_status) %></th><th><%= l(:label_gk_core_stuff_view_hooks_views) %></th><th><%= l(:label_gk_core_stuff_view_hooks_used) %></th></tr></thead>
    <tbody>
    <% { layout_hooks: GkCoreStuff::LayoutHooks, action_menus: GkCoreStuff::ActionMenus, form_hooks: GkCoreStuff::FormHooks, list_hooks: GkCoreStuff::ListHooks, section_marks: GkCoreStuff::SectionMarks, anchor_marks: GkCoreStuff::AnchorMarks, more_view_hooks: GkCoreStuff::MoreViewHooks }.each do |key, mod| %>
      <% heard = mod::HOOKS.select { |h| ::Redmine::Hook.hook_listeners(h).any? } %>
      <% heard += mod.items.reject { |_, v| v.empty? }.keys if mod.respond_to?(:items) %>
      <tr class="<%= cycle('odd', 'even') %>">
        <td class="name"><%= l(:"label_gk_core_stuff_#{key}") %><br><em class="info"><%= l(:"text_gk_core_stuff_#{key}_info") %></em></td>
        <%# the status as GK GUI Stuff's flag in the row: Redmine has it (info, the long text as its tooltip), or always on %>
        <td class="status"><%= GkCoreStuff.in_core?(key) ? gk_gui_stuff_flag(l(:label_gk_core_stuff_in_core), inline: true, role: :info, title: l(:text_gk_core_stuff_in_core)) : gk_gui_stuff_flag(l(:label_gk_core_stuff_view_hooks_always), inline: true, role: :tip) %></td>
        <% marks = GkCoreStuff.marks?(key) %>
        <td><%= mod.views_dir ? l(:text_gk_core_stuff_layout_hooks_views_ok) : (marks ? l(:text_gk_core_stuff_view_marks_views_missing) : l(:text_gk_core_stuff_layout_hooks_views_missing)) %>
          <% shadowed = GkCoreStuff.shadowed_views(key) %>
          <% if shadowed.any? %><% views = shadowed.map { |v| v.sub(/\.html\.erb\z/, '') }.join(', ') %><br><em class="info"><%= marks ? l(:text_gk_core_stuff_view_marks_shadowed, views: views) : l(:text_gk_core_stuff_view_hooks_shadowed, views: views) %></em><% end %></td>
        <td><%= heard.any? ? heard.join(', ') : l(:label_none) %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
</fieldset>
<%# the change log, drawn by GK GUI Stuff %>
<%= gk_gui_stuff_changelog(:gk_core_stuff) %>
<% end %>
