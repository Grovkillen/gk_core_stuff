<div class="contextual">
<%= link_to sprite_icon('user', l(:label_profile)), user_path(@user), :class => 'icon icon-user' %>
<%= additional_emails_link(@user) %>
<%= change_status_link(@user) %>
<%= delete_link user_path(@user) if User.current != @user %>
</div>

<% html_title @user.login, l(:label_user_plural) %>
<h2><%= link_to l(:label_user_plural), users_path %> &#187; <%= avatar(@user) %><%= @user.login %></h2>
<%= call_hook(:view_layouts_base_title_after, :title => [[l(:label_user_plural), users_path], @user.login]) %>

<%= render_tabs user_settings_tabs %>
