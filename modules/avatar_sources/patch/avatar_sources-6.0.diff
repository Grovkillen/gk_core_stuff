+module Redmine
+  # A register of sources for the picture of a user or a group. A plugin adds a
+  # source with a position; AvatarsHelper#avatar asks the sources in order, before
+  # Gravatar, and the first one that returns HTML wins. A source is a block called
+  # with (principal, options, view) that returns the HTML of the picture, or nil to
+  # let the next source answer. Anonymous users never ask the sources.
+  #
+  #   Redmine::AvatarSources.register(:my_pictures, position: 10) do |user, options, view|
+  #     view.image_tag(...) if MyPicture.exists?(user_id: user.id)
+  #   end
+  module AvatarSources
+    Source = Struct.new(:name, :position, :block)
+
+    @sources = {}
+
+    class << self
+      def register(name, position: 100, &block)
+        @sources[name.to_s] = Source.new(name.to_s, position.to_i, block)
+      end
+
+      def unregister(name)
+        @sources.delete(name.to_s)
+      end
+
+      def sources
+        @sources.values.sort_by {|s| [s.position, s.name]}
+      end
+
+      def render(principal, options, view)
+        sources.each do |source|
+          html = source.block.call(principal, options, view)
+          return html if html.present?
+        end
+        nil
+      end
+    end
+  end
+end
