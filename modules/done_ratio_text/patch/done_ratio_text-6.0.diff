+
+  def test_progress_bar_with_text
+    with_settings :progress_bar_text => 'right' do
+      assert_select_in progress_bar(40, :text => true), 'div.progress-with-text.progress-text-right' do
+        assert_select 'table.progress'
+        assert_select 'span.progress-text', :text => '40%'
+      end
+    end
+  end
+
+  def test_progress_bar_with_text_hidden
+    with_settings :progress_bar_text => 'hidden' do
+      assert_select_in progress_bar(40, :text => true), 'span.progress-text.hidden-for-sighted', :text => '40%'
+    end
+  end
+
+  def test_progress_bar_with_text_respects_zero_and_full
+    with_settings :progress_bar_text => 'right', :progress_bar_text_zero => '0', :progress_bar_text_full => '0' do
+      assert_select_in progress_bar(0, :text => true), 'div.progress-text-right span.progress-text.progress-text-none', :text => ''
+      assert_select_in progress_bar(100, :text => true), 'div.progress-text-right span.progress-text.progress-text-none', :text => ''
+      assert_select_in progress_bar(50, :text => true), 'span.progress-text', :text => '50%'
+    end
+  end
+
+  def test_progress_bar_with_text_off
+    with_settings :progress_bar_text => '' do
+      assert_not_include 'progress-text', progress_bar(40, :text => true)
+    end
+  end
+
+  def test_progress_bar_without_text_option_is_unchanged
+    with_settings :progress_bar_text => 'over' do
+      assert_not_include 'progress-text', progress_bar(40)
+    end
+  end
 end
