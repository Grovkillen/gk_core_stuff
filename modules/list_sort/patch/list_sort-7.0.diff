+  # Returns the given projects in tree order, the projects under the same
+  # parent (or at the root) sorted by name
+  # The given collection may be a subset of the whole project tree
+  def sort_project_tree(projects)
+    roots = []
+    children = Hash.new {|h, k| h[k] = []}
+    ancestors = []
+    projects.sort_by(&:lft).each do |project|
+      ancestors.pop while ancestors.any? && !project.is_descendant_of?(ancestors.last)
+      (ancestors.any? ? children[ancestors.last.id] : roots) << project
+      ancestors << project
+    end
+    flatten = lambda do |nodes|
+      nodes.sort_by {|p| [p.name.to_s.downcase, p.lft]}.flat_map {|p| [p] + flatten.call(children[p.id])}
+    end
+    flatten.call(roots)
+  end
+
