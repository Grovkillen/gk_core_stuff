   # Returns the avatar image tag for the given +user+ if avatars are enabled
   # +user+ can be a User or a string that will be scanned for an email address (eg. 'joe <joe@foo.bar>')
   def avatar(user, options = {})
+    # A source registered by a plugin (Redmine::AvatarSources) answers first
+    if user.is_a?(Principal) && !user.is_a?(AnonymousUser)
+      html = Redmine::AvatarSources.render(user, options, self)
+      return html if html
+    end
+
     if Setting.gravatar_enabled?
       options[:default] = Setting.gravatar_default
       options[:class] = GravatarHelper::DEFAULT_OPTIONS[:class] + " " + options[:class] if options[:class]
