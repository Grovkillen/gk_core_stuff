--- a/app/assets/stylesheets/application.css
+++ b/app/assets/stylesheets/application.css
@@ -1571,6 +1571,12 @@
   color: var(--oc-pink-9);
 }
 
+/* A box without an icon at its start: the same space on both sides, and no margin of the first and
+   last child added to the padding */
+:is(.warning, .nodata, .conflict, div.flash):not(:has(> svg.icon-svg)) {padding-inline: 12px;}
+:is(.warning, .nodata, .conflict, div.flash):not(:has(> svg.icon-svg)) > :first-child {margin-block-start: 0;}
+:is(.warning, .nodata, .conflict, div.flash):not(:has(> svg.icon-svg)) > :last-child {margin-block-end: 0;}
+
 .warning .oauth-permissions { display:inline-block;text-align:start; }
 .warning .oauth-permissions p { margin-block-start: 0; -webkit-margin-before: 0;}
 
