--- a/app/assets/javascripts/application.js
+++ b/app/assets/javascripts/application.js
@@ -1367,7 +1367,101 @@
   };
 }(jQuery));
 
+/* The browser's validation messages in the language of the page */
+function validationMessage(field) {
+  var validity = field.validity;
+  var t = rm.I18n;
+  if (validity.valueMissing) {
+    if (field.type === 'checkbox') {return t.validationValueMissingCheckbox;}
+    if (field.tagName === 'SELECT' || field.type === 'radio') {return t.validationValueMissingSelect;}
+    return t.validationValueMissing;
+  }
+  if (validity.typeMismatch) {
+    if (field.type === 'email') {return t.validationTypeMismatchEmail;}
+    if (field.type === 'url') {return t.validationTypeMismatchUrl;}
+    return t.validationBadFormat;
+  }
+  if (validity.tooShort) {return t.validationTooShort.replace('%{count}', field.minLength);}
+  if (validity.tooLong) {return t.validationTooLong.replace('%{count}', field.maxLength);}
+  if (validity.rangeUnderflow) {return t.validationRangeUnderflow.replace('%{value}', field.min);}
+  if (validity.rangeOverflow) {return t.validationRangeOverflow.replace('%{value}', field.max);}
+  if (validity.patternMismatch || validity.stepMismatch || validity.badInput) {
+    return field.title || t.validationBadFormat;
+  }
+  return '';
+}
+
+function setValidationMessage(field) {
+  if (!field.willValidate || !window.rm || !rm.I18n || !rm.I18n.validationValueMissing) {return;}
+  /* a message set by another script is kept */
+  if (field.validity.customError && !$(field).data('validation-message')) {return;}
+  field.setCustomValidity('');
+  var message = validationMessage(field);
+  $(field).data('validation-message', message);
+  field.setCustomValidity(message);
+}
+
+function setupValidationMessages() {
+  var fields = 'input, select, textarea';
+  /* invalid does not bubble: listen in the capture phase */
+  document.addEventListener('invalid', function(event) {
+    if ($(event.target).is(fields)) {setValidationMessage(event.target);}
+  }, true);
+  $(document).on('input change focusin mouseover', fields, function() {
+    setValidationMessage(this);
+  });
+}
+
+/* File fields with a button and a text in the language of the page instead of
+   the browser's. The browser's field stays in the form, without its own button
+   and text. */
+function setupFileFields() {
+  if (!window.rm || !rm.I18n || !rm.I18n.labelFileChoose) {return;}
+  $('input[type=file]:not(.file-field-input)').each(function() {
+    var button = $('<button type="button" class="file-field-button"></button>')
+      .text(this.multiple ? rm.I18n.labelFilesChoose : rm.I18n.labelFileChoose);
+    var name = $('<span class="file-field-name"></span>').text(rm.I18n.labelNoFileChosen);
+    $(this).addClass('file-field-input').attr('tabindex', '-1').after(button, name);
+  });
+}
+
+$(document).on('click', '.file-field-button', function() {
+  $(this).prevAll('input[type=file]').first().click();
+});
+$(document).on('change', 'input.file-field-input', function() {
+  var count = this.files ? this.files.length : 0;
+  var text = rm.I18n.labelNoFileChosen;
+  if (count === 1) {
+    text = this.files[0].name;
+  } else if (count > 1) {
+    text = rm.I18n.labelXFilesChosen.replace('%{count}', count);
+  }
+  $(this).nextAll('.file-field-name').first().text(text);
+});
+/* a file dropped on the button or the text goes into the field, unless the
+   form has its own drop zone for attachments */
+$(document).on('dragover', '.file-field-button, .file-field-name', function(event) {
+  if ($(this).closest('.filedroplistner, .custom-field-filedroplistner').length) {return;}
+  event.preventDefault();
+  $(this).addClass('fileover');
+});
+$(document).on('dragleave drop', '.file-field-button, .file-field-name', function() {
+  $(this).removeClass('fileover');
+});
+$(document).on('drop', '.file-field-button, .file-field-name', function(event) {
+  if ($(this).closest('.filedroplistner, .custom-field-filedroplistner').length) {return;}
+  var files = event.originalEvent.dataTransfer && event.originalEvent.dataTransfer.files;
+  if (!files || files.length === 0) {return;}
+  event.preventDefault();
+  var input = $(this).prevAll('input[type=file]').first();
+  input[0].files = files;
+  input.trigger('change');
+});
+
 $(document).ready(setupAjaxIndicator);
+$(document).ready(setupValidationMessages);
+$(document).ready(setupFileFields);
+$(document).ajaxComplete(setupFileFields);
 $(document).ready(hideOnLoad);
 $(document).ready(addFormObserversForDoubleSubmit);
 $(document).ready(defaultFocus);
