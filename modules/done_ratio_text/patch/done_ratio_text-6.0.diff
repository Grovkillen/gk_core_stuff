--- a/app/assets/stylesheets/application.css
+++ b/app/assets/stylesheets/application.css
@@ -1416,6 +1416,22 @@
 table.progress td.done { background: #D3EDD3 none repeat scroll 0%; }
 table.progress td.todo { background: #eee none repeat scroll 0%; }
 p.percent {font-size: 86%; margin:0;}
+
+/* The value as text beside, on or below a progress bar (#5284). The bar
+   keeps its 80 px in every position, so that every bar in a column has the
+   same width; a value whose text is left out keeps an empty place for it. */
+div.progress-with-text table.progress {float: none; margin: 0; inline-size: 80px;}
+div.progress-text-right, div.progress-text-over, div.progress-text-under {vertical-align: middle;}
+div.progress-text-right {display: inline-flex; align-items: center; gap: 4px;}
+div.progress-text-right table.progress {flex: none;}
+div.progress-text-right .progress-text {flex: none; min-inline-size: 2.6em; text-align: end; font-size: 86%; line-height: 1;}
+div.progress-text-over {display: inline-grid; inline-size: 80px;}
+div.progress-text-over > * {grid-area: 1 / 1;}
+div.progress-text-over .progress-text {align-self: center; text-align: center; font-size: 75%; line-height: 1; color: #222; text-shadow: 0 0 2px #fff, 0 0 2px #fff;}
+div.progress-text-under {display: inline-block; inline-size: 80px;}
+div.progress-text-under .progress-text {display: block; text-align: center; font-size: 86%;}
+div.progress-text-under .progress-text-none::before {content: "\00a0";}
+td.done_ratio > div.progress-with-text {margin-inline: auto;}
 p.progress-info {clear: left; font-size: 86%; margin-top:-4px; color:#777;}
 
 .version-overview table.progress {width:40em;}
