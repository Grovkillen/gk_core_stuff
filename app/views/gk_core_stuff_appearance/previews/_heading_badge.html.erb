<%# Visa for badges level with the heading, drawn only from GK GUI Stuff's page Appearance with its helpers: a page's
    heading with the issue's status and Private after it (the style guide's badges, gk_gui_stuff_sg_badges), still,
    lifted as Redmine has it; with the setting, the same badges level with the heading's letters (the picture's own
    rule, gk_core_stuff_pictures.css; the look's stylesheet comes only with the row on). row: the setting %>
<% gk_gui_stuff_preview_stylesheet('gk_core_stuff_pictures', plugin: 'gk_core_stuff') %>
<% heading = safe_join([content_tag(:h2, "#{l(:label_issue)} #1", class: 'inline-block'),
                        gk_gui_stuff_sg_badges(l(:label_open_issues), only: [:open, :private])], ' ') %>
<%= gk_gui_stuff_appearance_preview(row, off: content_tag(:div, heading, class: 'gk-gui-stuff-sg-still', inert: true),
                                         on: content_tag(:div, heading, class: 'gk-gui-stuff-preview-on'), mid_line: true) %>
